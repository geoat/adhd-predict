{
  "schema_version": "1.1.0",
  "title": "ADHD symptom indication questions",
  "audience": "Adults answering for themselves",
  "language": "en",
  "purpose": "Collect self-reported symptoms and everyday impact for an ADHD indication score.",
  "instructions": "For q01–q18, consider your typical experience over the past six months. Choose one answer for each question. q19 asks about childhood. For q20, select every area affected, or select No noticeable problems or Not sure alone.",
  "response_format": {
    "single_select": "Store one option value.",
    "multi_select": "Store an array of unique option values. An option marked exclusive must be selected alone."
  },
  "scoring": {
    "name": "ADHD symptom indication score",
    "unit": "points_out_of_100",
    "weights": {
      "inattention": 0.4,
      "hyperactivity_impulsivity": 0.4,
      "impact": 0.2
    },
    "components": {
      "inattention": {
        "question_ids": [
          "q01",
          "q02",
          "q03",
          "q04",
          "q05",
          "q06",
          "q07",
          "q08",
          "q09"
        ],
        "raw_score": "sum(selected_option.score)",
        "max_raw_score": 36,
        "normalized_score": "100 * raw_score / 36"
      },
      "hyperactivity_impulsivity": {
        "question_ids": [
          "q10",
          "q11",
          "q12",
          "q13",
          "q14",
          "q15",
          "q16",
          "q17",
          "q18"
        ],
        "raw_score": "sum(selected_option.score)",
        "max_raw_score": 36,
        "normalized_score": "100 * raw_score / 36"
      },
      "impact": {
        "question_id": "q20",
        "count_values": [
          "home",
          "work",
          "education",
          "relationships",
          "other"
        ],
        "count_cap": 2,
        "normalized_score": "100 * min(count_selected_impact_values, 2) / 2",
        "none_score": 0,
        "unsure_score": null
      }
    },
    "context_only": {
      "question_id": "q19",
      "contributes_to_score": false
    },
    "formula": "0.40 * inattention + 0.40 * hyperactivity_impulsivity + 0.20 * impact",
    "rounding": "Round only the final score to the nearest integer (0.5 rounds up).",
    "completeness": "Require valid answers to all 20 questions. If q20 is unsure, the overall score is unavailable; show the inattention and hyperactivity_impulsivity component scores.",
    "interpretation": "Higher scores mean more frequently reported symptoms and/or impact. This is an unvalidated indication score, not a percentage chance or diagnosis."
  },
