{
  "schema_version": "2.0.0",
  "title": "Adult ADHD symptom and context questions",
  "audience": "Adults answering for themselves (18+)",
  "language": "en",
  "purpose": "Organize symptom and context responses for discussion during a clinical assessment.",
  "instructions": "For q01–q18, consider the past six months and choose how often each difficulty occurs. Answer q19 about childhood and each row of q20 about the broader context.",
  "response_format": {
    "single_select": "Store one option value.",
    "matrix_single_select": "Store one option value per row ID, for example q20: {duration:'yes', settings:'yes', impairment:'yes', possible_other_explanations:'unsure'}."
  },
  "assessment": {
    "method": "adult_symptom_count_and_context_review",
    "audience": "Adult self-report; age 18 or older.",
    "symptom_domains": {
      "inattention": {
        "question_ids": [
          "q01",
          "q02",
          "q03",
          "q04",
          "q05",
          "q06",
          "q07",
          "q08",
          "q09"
        ],
        "present_values": ["often", "very_often"],
        "points_per_present_item": 1,
        "threshold": 5,
        "max_count": 9
      },
      "hyperactivity_impulsivity": {
        "question_ids": [
          "q10",
          "q11",
          "q12",
          "q13",
          "q14",
          "q15",
          "q16",
          "q17",
          "q18"
        ],
        "present_values": ["often", "very_often"],
        "points_per_present_item": 1,
        "threshold": 5,
        "max_count": 9
      }
    },
    "presentation_pattern_rules": [
      {
        "code": "combined_pattern",
        "inattention_min": 5,
        "hyperactivity_impulsivity_min": 5
      },
      {
        "code": "inattentive_pattern",
        "inattention_min": 5,
        "hyperactivity_impulsivity_max": 4
      },
      {
        "code": "hyperactive_impulsive_pattern",
        "inattention_max": 4,
        "hyperactivity_impulsivity_min": 5
      },
      {
        "code": "below_count_threshold",
        "inattention_max": 4,
        "hyperactivity_impulsivity_max": 4
      }
    ],
    "context_checks": {
      "childhood_onset": "q19 == yes",
      "duration": "q20.duration == yes",
      "settings": "q20.settings == yes",
      "impairment": "q20.impairment == yes",
      "possible_other_explanations": "q20.possible_other_explanations"
    },
    "combination_rules": [
      {
        "code": "reported_pattern_with_context",
        "presentation_pattern_not": "below_count_threshold",
        "all_required_context_reported": true
      },
      {
        "code": "symptom_pattern_context_incomplete",
        "presentation_pattern_not": "below_count_threshold",
        "all_required_context_reported": false
      },
      {
        "code": "below_count_threshold",
        "presentation_pattern": "below_count_threshold"
      }
    ],
    "other_explanations_rule": "Always flag q20.possible_other_explanations == yes for clinical review. A 'no' or 'unsure' answer does not rule out another explanation.",
    "output_fields": [
      "inattention_count",
      "hyperactivity_impulsivity_count",
      "presentation_pattern",
      "childhood_onset_response",
      "duration_response",
      "settings_response",
      "impairment_response",
      "possible_other_explanations_response",
      "combination_code"
    ],
    "no_weighted_percentage": true,
    "interpretation": "Criteria-informed self-report summary, not a diagnosis. A clinician must assess developmental appropriateness, corroborating history, severity and impairment, other causes, and all diagnostic criteria.",
    "required_context_for_reported_pattern": {
      "q19": "yes",
      "q20.duration": "yes",
      "q20.settings": "yes",
      "q20.impairment": "yes"
    },
    "symptom_count_note": "Counting 'often' or 'very_often' is a questionnaire rule, not a validated mapping to a clinically established symptom."
  },
